{
  "name": "swipegig",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "powershell -ExecutionPolicy Bypass -Command \"cd backend; if (Test-Path .venv\\Scripts\\python.exe) { .venv\\Scripts\\python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000 } else { python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000 }\"",
    "dev:all": "concurrently -k -n \"vite,api\" -c \"cyan.bold,magenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
